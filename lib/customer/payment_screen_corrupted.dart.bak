import 'package:flutter/material.dart';
import 'package:google_maps_flutter/google_maps_flutter.dart';
import 'package:url_launcher/url_launcher.dart';
import '../main.dart';
import 'payment_methods_screen.dart';
import '../services/user_data_service.dart';
import '../services/pricing_service.dart';
import '../services/supabase_service.dart';
import '../screens/paymongo_qr_payment_screen.dart';
import '../models/invoice.dart';

class PaymentScreen extends StatefulWidget {
  final String? issueType;
  final String? issueDescription;
  final String? issueTitle;
  final String? vehicleType;
  final String? vehicleBrand;
  final String? vehicleModel;
  final String? vehicleYear;
  final String? vehicleId;
  final String? serviceRequestId;

  const PaymentScreen({
    Key? key,
    this.issueType,
    this.issueDescription,
    this.issueTitle,
    this.vehicleType,
    this.vehicleBrand,
    this.vehicleModel,
    this.vehicleYear,
    this.vehicleId,
    this.serviceRequestId,
  }) : super(key: key);

  @override
  State<PaymentScreen> createState() => _PaymentScreenState();
}

class _PaymentScreenState extends State<PaymentScreen> {
  String? _selectedPaymentMethod;
  bool _isProcessing = false;
  final TextEditingController _phoneController = TextEditingController();
  final _formKey = GlobalKey<FormState>();
  
  // Pricing calculation variables
  final PricingService _pricingService = PricingService();
  LatLng? _customerLocation;
  LatLng? _mechanicLocation;
  double? _serviceFee;
  double? _totalAmount;
  bool _isLoadingPricing = true;
  
  // Updated to hold both default and saved payment methods
  List<Map<String, dynamic>> _paymentMethods = [];
  bool _isLoadingPaymentMethods = true;

  @override
  void initState() {
    super.initState();
    // Add listener to phone controller to update button state
    _phoneController.addListener(() {
      setState(() {
        // This will trigger a rebuild to update button state
      });
    });
    
    // Load saved payment methods and location data
    _loadPaymentMethods();
    _loadLocationDataAndCalculatePricing();
  }

  /// Load payment methods from database and combine with default options
  Future<void> _loadPaymentMethods() async {
    try {
      setState(() {
        _isLoadingPaymentMethods = true;
      });

      // Get saved payment methods from database
      List<Map<String, dynamic>> savedMethods = [];
      try {
        savedMethods = await UserDataService.getPaymentMethods();
        print('📋 Loaded ${savedMethods.length} saved payment methods');
      } catch (e) {
        print('⚠️ Could not load saved payment methods: $e');
        savedMethods = [];
      }

      // Create default payment methods with proper structure
      final List<Map<String, dynamic>> defaultMethods = [
        {
          'id': 'gcash_default',
          'method_type': 'gcash',
          'display_name': 'GCash',
          'icon': Icons.account_balance_wallet,
          'color': Colors.blue,
          'requiresPhone': true,
          'is_saved': false,
        },
        {
          'id': 'paymaya_default',
          'method_type': 'paymaya', 
          'display_name': 'PayMaya',
          'icon': Icons.payment,
          'color': Colors.orange,
          'requiresPhone': true,
          'is_saved': false,
        },
        {
          'id': 'cash_default',
          'method_type': 'cash',
          'display_name': 'Cash on Service',
          'icon': Icons.money,
          'color': Colors.green,
          'requiresPhone': false,
          'is_saved': false,
        },
      ];

      // Process saved payment methods to add missing properties
      final List<Map<String, dynamic>> processedSavedMethods = savedMethods.map((method) {
        final methodType = method['method_type'] ?? '';
        
        // Add display properties based on method type
        IconData icon;
        Color color;
        bool requiresPhone;
        String displayName;

        switch (methodType.toLowerCase()) {
          case 'gcash':
            icon = Icons.account_balance_wallet;
            color = Colors.blue;
            requiresPhone = false; // Already saved, no need to enter again
            displayName = 'GCash (${_formatSavedNumber(method['gcash_number'])})';
            break;
          case 'paymaya':
            icon = Icons.payment;
            color = Colors.orange;
            requiresPhone = false; // Already saved, no need to enter again
            displayName = 'PayMaya (${_formatSavedNumber(method['paymaya_number'])})';
            break;
          case 'credit_card':
          case 'debit_card':
            icon = Icons.credit_card;
            color = Colors.purple;
            requiresPhone = false;
            final lastFour = method['card_last_four'] ?? '****';
            displayName = '${method['display_name'] ?? 'Card'} ••••$lastFour';
            break;
          default:
            icon = Icons.payment;
            color = Colors.grey;
            requiresPhone = false;
            displayName = method['display_name'] ?? 'Payment Method';
        }

        return {
          ...method,
          'icon': icon,
          'color': color,
          'requiresPhone': requiresPhone,
          'display_name': displayName,
          'is_saved': true,
        };
      }).toList();

      // Combine saved methods with default methods, prioritizing saved methods
      setState(() {
        _paymentMethods = [...processedSavedMethods, ...defaultMethods];
        _isLoadingPaymentMethods = false;
      });

      print('✅ Payment methods loaded: ${_paymentMethods.length} total (${processedSavedMethods.length} saved, ${defaultMethods.length} default)');

    } catch (e) {
      print('❌ Error loading payment methods: $e');
      
      // Fallback to default methods only
      setState(() {
        _paymentMethods = [
          {
            'id': 'gcash_default',
            'method_type': 'gcash',
            'display_name': 'GCash',
            'icon': Icons.account_balance_wallet,
            'color': Colors.blue,
            'requiresPhone': true,
            'is_saved': false,
          },
          {
            'id': 'paymaya_default',
            'method_type': 'paymaya',
            'display_name': 'PayMaya',
            'icon': Icons.payment,
            'color': Colors.orange,
            'requiresPhone': true,
            'is_saved': false,
          },
          {
            'id': 'cash_default',
            'method_type': 'cash',
            'display_name': 'Cash on Service',
            'icon': Icons.money,
            'color': Colors.green,
            'requiresPhone': false,
            'is_saved': false,
          },
        ];
        _isLoadingPaymentMethods = false;
      });
    }
  }

  /// Format saved phone numbers for display (show last 4 digits)
  String _formatSavedNumber(String? number) {
    if (number == null || number.isEmpty) return 'Not set';
    if (number.length <= 4) return number;
    return '••••${number.substring(number.length - 4)}';
  }

  @override
  void dispose() {
    _phoneController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: Colors.white,
        elevation: 0,
        leading: IconButton(
          icon: const Icon(Icons.arrow_back, color: Colors.black),
          onPressed: () => Navigator.pop(context),
        ),
        title: const Text(
          'Payment',
          style: TextStyle(
            color: Colors.black,
            fontWeight: FontWeight.bold,
          ),
        ),
      ),
      body: Form(
        key: _formKey,
        child: Column(
          children: [
            // Progress bar
            Container(
              width: double.infinity,
              height: 8,
              color: Colors.grey[200],
              child: Row(
                children: [
                  Container(
                    width: MediaQuery.of(context).size.width,
                    height: 8,
                    color: const Color.fromARGB(255, 176, 12, 1),
                  ),
                ],
              ),
            ),

            Expanded(
              child: SingleChildScrollView(
                padding: const EdgeInsets.all(16.0),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    // Service Summary Card
                    _buildServiceSummaryCard(),
                    
                    const SizedBox(height: 24),
                    
                    // Mechanic Assigned Section
                    _buildMechanicAssignedSection(),
                    
                    const SizedBox(height: 24),
                    
                    // Payment Methods Section
                    _buildPaymentMethodsSection(),
                    
                    // Phone number input (shown when GCash or PayMaya is selected)
                    if (_selectedPaymentMethod != null && 
                        _getSelectedMethodRequiresPhone()) ...[
                      const SizedBox(height: 20),
                      _buildPhoneNumberInput(),
                    ],
                      const SizedBox(height: 24),
                    
                    // Total Amount Card
                    _buildTotalAmountCard(),
                    
                    const SizedBox(height: 16),
                    
                    // Payment Cancellation Note
                    _buildPaymentCancellationNote(),
                  ],
                ),
              ),
            ),

            // Confirm Button
            _buildConfirmButton(),
          ],
        ),
      ),
    );
  }

  Widget _buildServiceSummaryCard() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(12),
        boxShadow: [
          BoxShadow(
            color: Colors.grey.withOpacity(0.1),
            spreadRadius: 1,
            blurRadius: 4,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Service Summary',
            style: TextStyle(
              fontSize: 18,
              fontWeight: FontWeight.bold,
              color: Colors.grey[800],
            ),
          ),
          const SizedBox(height: 12),
          _buildSummaryRow('Service Type', widget.issueTitle ?? 'General Service'),
          _buildSummaryRow('Vehicle', '${widget.vehicleBrand ?? ''} ${widget.vehicleModel ?? ''} ${widget.vehicleYear ?? ''}'.trim()),
          _buildSummaryRow('Description', widget.issueDescription ?? 'No description provided'),
        ],
      ),
    );
  }

  Widget _buildMechanicAssignedSection() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: const Color.fromARGB(255, 232, 245, 233),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(
          color: const Color.fromARGB(255, 76, 175, 80),
          width: 1,
        ),
      ),
      child: Row(
        children: [
          Container(
            padding: const EdgeInsets.all(8),
            decoration: const BoxDecoration(
              color: Color.fromARGB(255, 76, 175, 80),
              shape: BoxShape.circle,
            ),
            child: const Icon(
              Icons.check,
              color: Colors.white,
              size: 24,
            ),
          ),
          const SizedBox(width: 16),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text(
                  'Mechanic Assigned!',
                  style: TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.bold,
                    color: Color.fromARGB(255, 27, 94, 32),
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  'A qualified mechanic has accepted your request. Complete payment to confirm the service.',
                  style: TextStyle(
                    fontSize: 14,
