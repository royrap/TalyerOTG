// ========================================

Table progress_photos {
  id uuid [pk, default: `gen_random_uuid()`]
  service_request_id uuid [ref: > service_requests.id]
  mechanic_id uuid [ref: > user_profiles.id]
  service_phase varchar(30)
  image_url text
  description text
  timestamp timestamptz [default: `now()`]
  
  Indexes {
    service_request_id
  }
  
  Note: 'Job progress documentation photos'
}

Table service_phase_tracking {
  id uuid [pk, default: `gen_random_uuid()`]
  service_request_id uuid [unique, ref: - service_requests.id]
  mechanic_id uuid [ref: > user_profiles.id]
  current_phase varchar(30)
  phase_started_at timestamptz
  phase_history jsonb
  created_at timestamptz [default: `now()`]
  
  Note: 'Service phase progression tracking'
}

// ========================================
// 9. SECURITY & AUTHENTICATION TABLES
// ========================================

Table account_security_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > auth.users.id]
  action_type varchar(50)
  ip_address inet
  user_agent text
  success boolean [default: true]
  created_at timestamptz [default: `now()`]
  
  Indexes {
    user_id
  }
  
  Note: 'User security event logs'
}

Table password_reset_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > auth.users.id]
  token text [unique, not null]
  expires_at timestamptz
  used_at timestamptz
  is_active boolean [default: true]
  created_at timestamptz [default: `now()`]
  
  Note: 'Password reset tokens'
}

Table email_verification_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > auth.users.id]
  old_email varchar(255)
  new_email varchar(255)
  token text [unique, not null]
  token_type varchar(20)
  expires_at timestamptz
  created_at timestamptz [default: `now()`]
  
  Note: 'Email verification tokens'
}

